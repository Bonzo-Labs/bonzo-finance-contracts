{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bonzo.finance/dao/bundle.schema.json",
  "title": "DAO Bundle",
  "type": "object",
  "required": ["bipId", "targetSafe", "actions"],
  "properties": {
    "bipId": { "type": "string", "minLength": 1 },
    "targetSafe": { "enum": ["executor", "guardian"] },
    "description": { "type": "string" },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "action.schema.json" }
    }
  },
  "additionalProperties": false
}
